@model GymManagementSystem.Models.Subscription
@{
    ViewData["Title"] = "Add Subscription";
}

<div class="d-flex align-items-center gap-2 mb-4">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left"></i>
    </a>
    <h4 class="fw-bold mb-0"><i class="bi bi-credit-card"></i> Add Subscription</h4>
</div>

<div class="card border-0 shadow-sm" style="max-width:600px;">
    <div class="card-body p-4">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="row g-3">

                <!-- Member -->
                <div class="col-12">
                    <label asp-for="MemberId" class="form-label fw-semibold">Member</label>
                    <select asp-for="MemberId" id="MemberId" class="form-select"
                            asp-items="ViewBag.Members" required>
                        <option value="">— Select Member —</option>
                    </select>
                    <span asp-validation-for="MemberId" class="text-danger small"></span>
                </div>

                <!-- Plan -->
                <div class="col-md-6">
                    <label asp-for="Plan" class="form-label fw-semibold">Plan</label>
                    <select asp-for="Plan" id="Plan" class="form-select"
                            asp-items="Html.GetEnumSelectList<GymManagementSystem.Models.SubscriptionPlan>()">
                    </select>
                </div>

                <!-- Amount -->
                <div class="col-md-6">
                    <label asp-for="Amount" class="form-label fw-semibold">Amount (Rs.)</label>
                    <div class="input-group">
                        <span class="input-group-text">Rs.</span>
                        <input asp-for="Amount" id="Amount" type="number"
                               class="form-control" placeholder="2500" min="0" step="100" />
                    </div>
                    <span asp-validation-for="Amount" class="text-danger small"></span>
                </div>

                <!-- Start Date -->
                <div class="col-md-6">
                    <label asp-for="StartDate" class="form-label fw-semibold">Start Date</label>
                    <input asp-for="StartDate" id="StartDate" type="date" class="form-control" />
                    <span asp-validation-for="StartDate" class="text-danger small"></span>
                </div>

                <!-- End Date -->
                <div class="col-md-6">
                    <label asp-for="EndDate" class="form-label fw-semibold">End Date</label>
                    <input asp-for="EndDate" id="EndDate" type="date" class="form-control" />
                    <span asp-validation-for="EndDate" class="text-danger small"></span>
                    <div class="form-text text-info">
                        <i class="bi bi-info-circle"></i> Auto-calculated from plan
                    </div>
                </div>

                <!-- Plan Price Helper -->
                <div class="col-12">
                    <div class="alert alert-info py-2 mb-0 small" id="planInfo" style="display:none;">
                        <i class="bi bi-tag"></i> <span id="planInfoText"></span>
                    </div>
                </div>

                <!-- Payment -->
                <div class="col-12">
                    <div class="card bg-light border-0 p-3">
                        <div class="form-check form-switch">
                            <input asp-for="IsPaid" id="IsPaid"
                                   class="form-check-input" type="checkbox" />
                            <label asp-for="IsPaid" class="form-check-label fw-semibold">
                                Payment Received
                            </label>
                        </div>
                    </div>
                </div>

            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary px-4">
                    <i class="bi bi-check-lg"></i> Save Subscription
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        // Plan default prices
        const planPrices = {
            0: { label: 'Monthly (1 month)',     price: 2500,  months: 1  },
            1: { label: 'Quarterly (3 months)',  price: 6500,  months: 3  },
            2: { label: 'Semi-Annual (6 months)',price: 11000, months: 6  },
            3: { label: 'Annual (12 months)',    price: 18000, months: 12 }
        };

        function addMonths(date, months) {
            const d = new Date(date);
            d.setMonth(d.getMonth() + months);
            return d.toISOString().split('T')[0];
        }

        function updateFromPlan() {
            const planVal  = document.getElementById('Plan').value;
            const startVal = document.getElementById('StartDate').value;
            const info     = planPrices[planVal];

            if (!info) return;

            // Auto-fill amount
            document.getElementById('Amount').value = info.price;

            // Auto-fill end date
            if (startVal) {
                document.getElementById('EndDate').value = addMonths(startVal, info.months);
            }

            // Show plan info
            const infoBox  = document.getElementById('planInfo');
            const infoText = document.getElementById('planInfoText');
            infoBox.style.display  = 'block';
            infoText.textContent   = `${info.label} — Suggested price: Rs. ${info.price.toLocaleString()}`;
        }

        document.getElementById('Plan').addEventListener('change', updateFromPlan);
        document.getElementById('StartDate').addEventListener('change', function () {
            const planVal = document.getElementById('Plan').value;
            const info    = planPrices[planVal];
            if (info && this.value) {
                document.getElementById('EndDate').value = addMonths(this.value, info.months);
            }
        });

        // Set today as default start date on page load
        window.addEventListener('DOMContentLoaded', function () {
            const startInput = document.getElementById('StartDate');
            if (!startInput.value) {
                const today = new Date().toISOString().split('T')[0];
                startInput.value = today;
            }
        });
    </script>
}