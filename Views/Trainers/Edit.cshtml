@model GymManagementSystem.Models.Trainer
@{
    ViewData["Title"] = "Edit Trainer";
}

<div class="d-flex align-items-center gap-2 mb-4">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left"></i>
    </a>
    <h4 class="fw-bold mb-0"><i class="bi bi-pencil"></i> Edit Trainer</h4>
</div>

<div class="card border-0 shadow-sm" style="max-width:650px;">
    <div class="card-body p-4">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="Id" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="FullName" class="form-label fw-semibold"></label>
                    <input asp-for="FullName" class="form-control" />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Email" class="form-label fw-semibold"></label>
                    <input asp-for="Email" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Phone" class="form-label fw-semibold"></label>
                    <input asp-for="Phone" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Specialization" class="form-label fw-semibold"></label>
                    <select asp-for="Specialization" class="form-select">
                        <option>Weight Training</option>
                        <option>Cardio</option>
                        <option>Yoga</option>
                        <option>CrossFit</option>
                        <option>Boxing</option>
                        <option>Nutrition</option>
                        <option>Rehabilitation</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label asp-for="HireDate" class="form-label fw-semibold"></label>
                    <input asp-for="HireDate" type="date" class="form-control" />
                </div>
                <div class="col-md-6 d-flex align-items-end">
                    <div class="form-check form-switch">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                        <label asp-for="IsActive" class="form-check-label">Active Trainer</label>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-warning px-4">
                    <i class="bi bi-check-lg"></i> Update Trainer
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>