@model GymManagementSystem.Models.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<!-- Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>               
        <h4 class="fw-bold mb-0">
            <i class="bi bi-speedometer2"></i> Dashboard
        </h4>
        <span class="text-muted small">
            Welcome back,
            <strong>@User.Identity?.Name</strong> —
            @DateTime.Now.ToString("dddd, dd MMM yyyy")
        </span>
    </div>
    @if (User.IsInRole("Admin"))
    {
        <span class="badge bg-danger px-3 py-2 fs-6">
            <i class="bi bi-shield-fill"></i> Administrator
        </span>
    }
    else
    {
        <span class="badge bg-info px-3 py-2 fs-6">
            <i class="bi bi-person-fill"></i> Operator
        </span>
    }
</div>

<!-- ── Row 1: Stats Cards ──────────────────────────── -->
<div class="row g-4 mb-4">

    <!-- Members -->
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm border-start border-primary border-4 h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-circle bg-primary bg-opacity-10 p-3">
                    <i class="bi bi-people-fill text-primary fs-3"></i>
                </div>
                <div>
                    <div class="text-muted small">Total Members</div>
                    <div class="fw-bold fs-3 text-primary">@Model.TotalMembers</div>
                    <div class="text-success small">
                        <i class="bi bi-check-circle"></i>
                        @Model.ActiveMembers active
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Trainers -->
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm border-start border-success border-4 h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-circle bg-success bg-opacity-10 p-3">
                    <i class="bi bi-person-badge-fill text-success fs-3"></i>
                </div>
                <div>
                    <div class="text-muted small">Total Trainers</div>
                    <div class="fw-bold fs-3 text-success">@Model.TotalTrainers</div>
                    <div class="text-success small">
                        <i class="bi bi-check-circle"></i>
                        @Model.ActiveTrainers active
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Today's Attendance -->
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm border-start border-warning border-4 h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-circle bg-warning bg-opacity-10 p-3">
                    <i class="bi bi-calendar-check-fill text-warning fs-3"></i>
                </div>
                <div>
                    <div class="text-muted small">Today's Check-ins</div>
                    <div class="fw-bold fs-3 text-warning">@Model.TodayCheckIns</div>
                    <div class="text-info small">
                        <i class="bi bi-person-check"></i>
                        @Model.CurrentlyInGym currently in gym
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Active Subscriptions -->
    <div class="col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm border-start border-danger border-4 h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-circle bg-danger bg-opacity-10 p-3">
                    <i class="bi bi-credit-card-fill text-danger fs-3"></i>
                </div>
                <div>
                    <div class="text-muted small">Active Subscriptions</div>
                    <div class="fw-bold fs-3 text-danger">
                        @Model.ActiveSubscriptions
                    </div>
                    <div class="text-warning small">
                        <i class="bi bi-exclamation-circle"></i>
                        @Model.UnpaidSubscriptions unpaid
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

<!-- ── Row 2: Revenue + Quick Actions ──────────────── -->
<div class="row g-4 mb-4">

    <!-- Monthly Revenue — Admin only -->
    @if (User.IsInRole("Admin"))
    {
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100"
                 style="background: linear-gradient(135deg,#1e2330,#2d3446);">
                <div class="card-body text-white p-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="small opacity-75">Monthly Revenue</div>
                            <div class="fw-bold fs-2 mt-1">
                                Rs. @Model.MonthlyRevenue.ToString("N0")
                            </div>
                            <div class="small opacity-75 mt-1">
                                <i class="bi bi-calendar-month"></i>
                                @DateTime.Now.ToString("MMMM yyyy")
                            </div>
                        </div>
                        
                    </div>
                    <hr class="border-secondary mt-3" />
                    <a asp-controller="Reports" asp-action="Index"
                           class="text-warning text-decoration-none small">
                        <i class="bi bi-arrow-right-circle"></i> View Full Report
                    </a>
                </div>
            </div>
        </div>
    }

    <!-- Quick Actions -->
    <div class="col-md-@(User.IsInRole("Admin") ? "4" : "6")">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white fw-semibold border-0 pt-3 pb-0">
                <i class="bi bi-lightning-fill text-warning"></i> Quick Actions
            </div>
            <div class="card-body d-grid gap-2">
                <a asp-controller="Members" asp-action="Create"
                       class="btn btn-outline-primary text-start">
                    <i class="bi bi-person-plus me-2"></i> Add New Member
                </a>
                <a asp-controller="Trainers" asp-action="Create"
                       class="btn btn-outline-success text-start">
                    <i class="bi bi-person-badge me-2"></i> Add New Trainer
                </a>
                <a asp-controller="Attendance" asp-action="CheckIn"
                       class="btn btn-outline-warning text-start">
                    <i class="bi bi-box-arrow-in-right me-2"></i> Record Check-in
                </a>
                <a asp-controller="Subscriptions" asp-action="Create"
                       class="btn btn-outline-info text-start">
                    <i class="bi bi-credit-card me-2"></i> Add Subscription
                </a>
            </div>
        </div>
    </div>

    <!-- Expiring Subscriptions -->
    <div class="col-md-@(User.IsInRole("Admin") ? "4" : "6")">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white fw-semibold border-0 pt-3 pb-0">
                <i class="bi bi-exclamation-triangle text-danger"></i>
                Expiring This Week
                <span class="badge bg-danger ms-1">
                    @Model.ExpiringThisWeek.Count
                </span>
            </div>
            <div class="card-body p-0">
                @if (Model.ExpiringThisWeek.Any())
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var sub in Model.ExpiringThisWeek)
                        {
                            <li class="list-group-item px-3 py-2">
                                <div class="d-flex justify-content-between">
                                    <span class="fw-semibold small">
                                        @sub.Member?.FullName
                                    </span>
                                    <span class="text-danger small">
                                        @sub.EndDate.ToString("dd MMM")
                                    </span>
                                </div>
                                <span class="badge bg-warning text-dark">
                                    @sub.Plan
                                </span>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <div class="text-center text-muted py-4">
                        <i class="bi bi-check-circle text-success fs-3"></i>
                        <div class="small mt-1">No expiring subscriptions</div>
                    </div>
                }
            </div>
        </div>
    </div>

</div>

<!-- ── Row 3: Recent Members + Today Attendance ─────── -->
<div class="row g-4">

    <!-- Recent Members -->
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white fw-semibold border-0 pt-3 pb-0
                d-flex justify-content-between align-items-center">
                <span>
                    <i class="bi bi-person-plus text-primary"></i> Recent Members
                </span>
                <a asp-controller="Members" asp-action="Index"
                       class="btn btn-sm btn-outline-primary">
                    View All
                </a>
            </div>
            <div class="card-body p-0">
                <ul class="list-group list-group-flush">
                    @if (Model.RecentMembers.Any())
                    {
                        @foreach (var member in Model.RecentMembers)
                        {
                            <li class="list-group-item px-3 py-2">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="rounded-circle bg-primary text-white
                                        d-flex align-items-center justify-content-center
                                        fw-bold flex-shrink-0"
                                         style="width:36px;height:36px;font-size:.85rem;">
                                        @member.FullName.Substring(0, 1).ToUpper()
                                    </div>
                                    <div class="flex-grow-1">
                                        <div class="fw-semibold small">@member.FullName</div>
                                        <div class="text-muted" style="font-size:.75rem;">
                                            @member.Email
                                        </div>
                                    </div>
                                    <div class="text-end">
                                        <div class="text-muted" style="font-size:.75rem;">
                                            @member.JoinDate.ToString("dd MMM")
                                        </div>
                                        @if (member.IsActive)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactive</span>
                                        }
                                    </div>
                                </div>
                            </li>
                        }
                    }
                    else
                    {
                        <li class="list-group-item text-center text-muted py-4">
                            <i class="bi bi-inbox"></i> No members yet
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>

    <!-- Today's Attendance -->
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white fw-semibold border-0 pt-3 pb-0
                d-flex justify-content-between align-items-center">
                <span>
                    <i class="bi bi-calendar-check text-warning"></i>
                    Today's Attendance
                </span>
                <a asp-controller="Attendance" asp-action="Index"
                       class="btn btn-sm btn-outline-warning">
                    View All
                </a>
            </div>
            <div class="card-body p-0">
                <ul class="list-group list-group-flush">
                    @if (Model.TodayAttendances.Any())
                    {
                        @foreach (var att in Model.TodayAttendances)
                        {
                            <li class="list-group-item px-3 py-2">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="rounded-circle bg-success text-white
                                        d-flex align-items-center justify-content-center
                                        fw-bold flex-shrink-0"
                                         style="width:36px;height:36px;font-size:.85rem;">
                                        @(att.Member?.FullName?.Substring(0, 1).ToUpper() ?? "?")
                                    </div>
                                    <div class="flex-grow-1">
                                        <div class="fw-semibold small">
                                            @att.Member?.FullName
                                        </div>
                                        <div class="text-muted" style="font-size:.75rem;">
                                            In: @att.CheckIn.ToString("hh:mm tt")
                                        </div>
                                    </div>
                                    <div class="text-end">
                                        @if (att.CheckOut == null)
                                        {
                                            <span class="badge bg-success">In Gym</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Out: @att.CheckOut.Value.ToString("hh:mm tt")
                                            </span>
                                        }
                                    </div>
                                </div>
                            </li>
                        }
                    }
                    else
                    {
                        <li class="list-group-item text-center text-muted py-4">
                            <i class="bi bi-inbox"></i> No check-ins today
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>

</div>