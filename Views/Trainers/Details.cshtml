@model GymManagementSystem.Models.Trainer
@{
    ViewData["Title"] = "Trainer Details";
}

<div class="d-flex align-items-center gap-2 mb-4">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left"></i>
    </a>
    <h4 class="fw-bold mb-0">
        <i class="bi bi-person-badge"></i> Trainer Details
    </h4>
</div>

<div class="row g-4">

    <!-- ── LEFT: Trainer Profile Card ───────────────── -->
    <div class="col-md-4">
        <div class="card border-0 shadow-sm text-center p-4">

            <!-- Avatar -->
            <div class="rounded-circle bg-success text-white d-flex align-items-center
                justify-content-center fw-bold mx-auto mb-3"
                 style="width:80px;height:80px;font-size:2rem;">
                @Model.FullName.Substring(0, 1).ToUpper()
            </div>

            <h5 class="fw-bold mb-1">@Model.FullName</h5>

            <span class="badge bg-info text-dark mb-3">
                <i class="bi bi-award"></i> @Model.Specialization
            </span>

            <!-- Status -->
            @if (Model.IsActive)
            {
                <span class="badge bg-success mb-3">
                    <i class="bi bi-check-circle"></i> Active Trainer
                </span>
            }
            else
            {
                <span class="badge bg-secondary mb-3">Inactive</span>
            }

            <hr />

            <!-- Info List -->
            <ul class="list-unstyled text-start small">
                <li class="mb-3 d-flex align-items-center gap-2">
                    <div class="rounded-circle bg-primary bg-opacity-10 p-2">
                        <i class="bi bi-envelope text-primary"></i>
                    </div>
                    <div>
                        <div class="text-muted" style="font-size:.7rem;">EMAIL</div>
                        <div class="fw-semibold">@Model.Email</div>
                    </div>
                </li>
                <li class="mb-3 d-flex align-items-center gap-2">
                    <div class="rounded-circle bg-success bg-opacity-10 p-2">
                        <i class="bi bi-telephone text-success"></i>
                    </div>
                    <div>
                        <div class="text-muted" style="font-size:.7rem;">PHONE</div>
                        <div class="fw-semibold">@Model.Phone</div>
                    </div>
                </li>
                <li class="mb-3 d-flex align-items-center gap-2">
                    <div class="rounded-circle bg-warning bg-opacity-10 p-2">
                        <i class="bi bi-calendar text-warning"></i>
                    </div>
                    <div>
                        <div class="text-muted" style="font-size:.7rem;">HIRE DATE</div>
                        <div class="fw-semibold">
                            @Model.HireDate.ToString("dd MMM yyyy")
                        </div>
                    </div>
                </li>
                <li class="d-flex align-items-center gap-2">
                    <div class="rounded-circle bg-info bg-opacity-10 p-2">
                        <i class="bi bi-people text-info"></i>
                    </div>
                    <div>
                        <div class="text-muted" style="font-size:.7rem;">TOTAL MEMBERS</div>
                        <div class="fw-semibold">@Model.Members.Count assigned</div>
                    </div>
                </li>
            </ul>

            <hr />

            <!-- Action Buttons -->
            <div class="d-grid gap-2">
                <a asp-action="Edit" asp-route-id="@Model.Id"
                       class="btn btn-warning btn-sm">
                    <i class="bi bi-pencil"></i> Edit Trainer
                </a>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-grid"></i> All Trainers
                </a>
            </div>
        </div>
    </div>

    <!-- ── RIGHT: Members List ───────────────────────── -->
    <div class="col-md-8">
        <div class="card border-0 shadow-sm">

            <!-- Card Header -->
            <div class="card-header bg-white border-0 pt-3 pb-0
                d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0">
                    <i class="bi bi-people-fill text-primary"></i>
                    Assigned Members
                    <span class="badge bg-primary ms-2">
                        @Model.Members.Count
                    </span>
                </h6>
                <a asp-controller="Members" asp-action="Create"
                       class="btn btn-sm btn-primary">
                    <i class="bi bi-person-plus"></i> Add Member
                </a>
            </div>

            <div class="card-body p-0">

                @if (Model.Members.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Member</th>
                                    <th>Contact</th>
                                    <th>Join Date</th>
                                    <th>Subscription</th>
                                    <th>Status</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var member in Model.Members
                                                                    .OrderBy(m => m.FullName))
                                {
                                    <!-- Get active subscription -->
                                    var activeSub = member.Subscriptions
                                        .FirstOrDefault(s =>
                                            s.StartDate <= DateTime.Today &&
                                            s.EndDate >= DateTime.Today);

                                    <tr>
                                        <!-- Member Name & Avatar -->
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="rounded-circle bg-primary text-white
                                                    d-flex align-items-center
                                                    justify-content-center fw-bold
                                                    flex-shrink-0"
                                                     style="width:38px;height:38px;
                                                    font-size:.85rem;">
                                                    @member.FullName.Substring(0, 1).ToUpper()
                                                </div>
                                                <div>
                                                    <div class="fw-semibold small">
                                                        @member.FullName
                                                    </div>
                                                    <div class="text-muted"
                                                         style="font-size:.72rem;">
                                                        @member.Email
                                                    </div>
                                                </div>
                                            </div>
                                        </td>

                                        <!-- Phone -->
                                        <td class="small">
                                            <i class="bi bi-telephone text-muted"></i>
                                            @member.Phone
                                        </td>

                                        <!-- Join Date -->
                                        <td class="small text-muted">
                                            @member.JoinDate.ToString("dd MMM yyyy")
                                        </td>

                                        <!-- Subscription -->
                                        <td>
                                            @if (activeSub != null)
                                            {
                                                <div>
                                                    <span class="badge bg-success">
                                                        @activeSub.Plan
                                                    </span>
                                                    <div class="text-muted mt-1"
                                                         style="font-size:.72rem;">
                                                        Expires:
                                                        @activeSub.EndDate
                                                        .ToString("dd MMM yyyy")
                                                    </div>
                                                </div>
                                            }
                                            else if (member.Subscriptions.Any())
                                            {
                                                <span class="badge bg-danger">
                                                    Expired
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">
                                                    No Plan
                                                </span>
                                            }
                                        </td>

                                        <!-- Active Status -->
                                        <td>
                                            @if (member.IsActive)
                                            {
                                                <span class="badge bg-success">
                                                    <i class="bi bi-check2"></i> Active
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">
                                                    Inactive
                                                </span>
                                            }
                                        </td>

                                        <!-- Actions -->
                                        <td>
                                            <div class="d-flex gap-1">
                                                <a asp-controller="Members"
                                                       asp-action="Details"
                                                       asp-route-id="@member.Id"
                                                       class="btn btn-sm btn-outline-info"
                                                       title="View Details">
                                                    <i class="bi bi-eye"></i>
                                                </a>
                                                <a asp-controller="Members"
                                                       asp-action="Edit"
                                                       asp-route-id="@member.Id"
                                                       class="btn btn-sm btn-outline-warning"
                                                       title="Edit">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Summary Footer -->
                    <div class="card-footer bg-light border-0 d-flex gap-4 py-2 px-3">
                        <div class="small text-muted">
                            <i class="bi bi-people text-primary"></i>
                            <strong>@Model.Members.Count(m => m.IsActive)</strong>
                            active members
                        </div>
                        <div class="small text-muted">
                            <i class="bi bi-credit-card text-success"></i>
                            <strong>
                                @Model.Members.Count(m => m.Subscriptions.Any(s =>
                                    s.StartDate <= DateTime.Today &&
                                    s.EndDate >= DateTime.Today))
                            </strong>
                            with active subscription
                        </div>
                        <div class="small text-muted">
                            <i class="bi bi-exclamation-circle text-danger"></i>
                            <strong>
                                @Model.Members.Count(m => !m.Subscriptions.Any(s =>
                                    s.StartDate <= DateTime.Today &&
                                    s.EndDate >= DateTime.Today))
                            </strong>
                            no active subscription
                        </div>
                    </div>
                }
                else
                {
                    <!-- Empty State -->
                    <div class="text-center py-5">
                        <i class="bi bi-people text-muted"
                           style="font-size:3rem;"></i>
                        <h6 class="text-muted mt-3">No members assigned yet</h6>
                        <p class="text-muted small">
                            Assign this trainer when creating or editing a member.
                        </p>
                        <a asp-controller="Members" asp-action="Create"
                               class="btn btn-primary btn-sm mt-2">
                            <i class="bi bi-person-plus"></i> Add Member
                        </a>
                    </div>
                }

            </div>
        </div>
    </div>

</div>