@model IEnumerable<GymManagementSystem.Models.Subscription>
@{
    ViewData["Title"] = "Subscriptions";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0"><i class="bi bi-credit-card"></i> Subscriptions</h4>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Add Subscription
    </a>
</div>

<!-- Summary Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-md-3">
        <div class="card border-0 shadow-sm text-center py-3">
            <div class="fw-bold fs-4 text-primary">@Model.Count()</div>
            <div class="text-muted small">Total</div>
        </div>
    </div>
    <div class="col-sm-6 col-md-3">
        <div class="card border-0 shadow-sm text-center py-3">
            <div class="fw-bold fs-4 text-success">
                @Model.Count(s => s.IsActive)
            </div>
            <div class="text-muted small">Active</div>
        </div>
    </div>
    <div class="col-sm-6 col-md-3">
        <div class="card border-0 shadow-sm text-center py-3">
            <div class="fw-bold fs-4 text-danger">
                @Model.Count(s => !s.IsActive)
            </div>
            <div class="text-muted small">Expired</div>
        </div>
    </div>
    <div class="col-sm-6 col-md-3">
        <div class="card border-0 shadow-sm text-center py-3">
            <div class="fw-bold fs-4 text-warning">
                Rs. @Model.Where(s => s.IsPaid).Sum(s => s.Amount).ToString("N0")
            </div>
            <div class="text-muted small">Total Collected</div>
        </div>
    </div>
</div>

<!-- Search -->
<div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-2">
        <input type="text" id="searchInput" class="form-control"
               placeholder="🔍 Search by member name or plan..." />
    </div>
</div>

<!-- Table -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0" id="subTable">
            <thead class="table-dark">
                <tr>
                    <th>Member</th>
                    <th>Plan</th>
                    <th>Start Date</th>
                    <th>End Date</th>
                    <th>Amount</th>
                    <th>Paid</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var sub in Model)
                {
                    <tr>
                        <!-- Member -->
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="rounded-circle bg-primary text-white d-flex
                                    align-items-center justify-content-center fw-bold"
                                     style="width:32px;height:32px;font-size:.8rem;">
                                    @(sub.Member?.FullName?.Substring(0, 1).ToUpper() ?? "?")
                                </div>
                                <span class="fw-semibold">@sub.Member?.FullName</span>
                            </div>
                        </td>

                        <!-- Plan -->
                        <td>
                            @{
                                var planColor = sub.Plan switch
                                {
                                    GymManagementSystem.Models.SubscriptionPlan.Monthly => "primary",
                                    GymManagementSystem.Models.SubscriptionPlan.Quarterly => "info",
                                    GymManagementSystem.Models.SubscriptionPlan.SemiAnnual => "warning",
                                    GymManagementSystem.Models.SubscriptionPlan.Annual => "success",
                                    _ => "secondary"
                                };
                            }
                            <span class="badge bg-@planColor">@sub.Plan</span>
                        </td>

                        <!-- Start Date -->
                        <td>@sub.StartDate.ToString("dd MMM yyyy")</td>

                        <!-- End Date -->
                        <td>
                            @sub.EndDate.ToString("dd MMM yyyy")
                            @if (sub.EndDate < DateTime.Today)
                            {
                                <span class="badge bg-danger ms-1">Expired</span>
                            }
                            else if (sub.EndDate <= DateTime.Today.AddDays(7))
                            {
                                <span class="badge bg-warning text-dark ms-1">
                                    <i class="bi bi-exclamation-triangle"></i> Soon
                                </span>
                            }
                        </td>

                        <!-- Amount -->
                        <td class="fw-semibold">Rs. @sub.Amount.ToString("N0")</td>

                        <!-- Paid -->
                        <td class="text-center">
                            @if (sub.IsPaid)
                            {
                                <i class="bi bi-check-circle-fill text-success fs-5"
                                   title="Paid"></i>
                            }
                            else
                            {
                                <i class="bi bi-x-circle-fill text-danger fs-5"
                                   title="Unpaid"></i>
                            }
                        </td>

                        <!-- Status -->
                        <td>
                            @if (sub.IsActive)
                            {
                                <span class="badge bg-success">
                                    <i class="bi bi-check2"></i> Active
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Expired</span>
                            }
                        </td>

                        <!-- Actions -->
                        <td>
                            <div class="d-flex gap-1 flex-wrap">

                                <!-- Edit — everyone -->
                                <a asp-action="Edit" asp-route-id="@sub.Id"
                                       class="btn btn-sm btn-outline-warning" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>

                                <!-- Mark Paid — Admin only, only if unpaid -->
                                @if (!sub.IsPaid && User.IsInRole("Admin"))
                                {
                                    <form asp-action="MarkPaid" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@sub.Id" />
                                        <button type="submit"
                                                class="btn btn-sm btn-outline-success"
                                                title="Mark as Paid"
                                                onclick="return confirm('Mark this subscription as paid?')">
                                            <i class="bi bi-check-circle"></i>
                                        </button>
                                    </form>
                                }

                                <!-- Delete — Admin only -->
                                @if (User.IsInRole("Admin"))
                                {
                                    <a asp-action="Delete" asp-route-id="@sub.Id"
                                           class="btn btn-sm btn-outline-danger"
                                           title="Delete"
                                           onclick="return confirm('Are you sure you want to delete this subscription?')">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                }

                            </div>
                        </td>
                    </tr>
                }

                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-5">
                            <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                            No subscriptions found.
                            <a asp-action="Create">Add one now.</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('searchInput').addEventListener('keyup', function () {
            const filter = this.value.toLowerCase();
            document.querySelectorAll('#subTable tbody tr').forEach(row => {
                row.style.display = row.textContent.toLowerCase().includes(filter) ? '' : 'none';
            });
        });
    </script>
}