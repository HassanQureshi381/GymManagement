@model IEnumerable<GymManagementSystem.Models.Trainer>
@{
    ViewData["Title"] = "Trainers";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0"><i class="bi bi-person-badge"></i> Trainers</h4>
    <a asp-action="Create" class="btn btn-success">
        <i class="bi bi-plus-lg"></i> Add Trainer
    </a>
</div>

<div class="row g-4">
    @foreach (var trainer in Model)
    {
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center p-4">

                    <!-- Avatar -->
                    <div class="rounded-circle bg-success text-white d-flex align-items-center
                        justify-content-center fw-bold mx-auto mb-3"
                         style="width:65px;height:65px;font-size:1.6rem;">
                        @trainer.FullName.Substring(0, 1).ToUpper()
                    </div>

                    <!-- Name & Specialization -->
                    <h6 class="fw-bold mb-1">@trainer.FullName</h6>
                    <span class="badge bg-info text-dark mb-3">
                        <i class="bi bi-award"></i> @trainer.Specialization
                    </span>

                    <!-- Contact Info -->
                    <p class="text-muted small mb-1">
                        <i class="bi bi-envelope"></i> @trainer.Email
                    </p>
                    <p class="text-muted small mb-1">
                        <i class="bi bi-telephone"></i> @trainer.Phone
                    </p>

                    <!-- Hire Date -->
                    <p class="text-muted small mb-2">
                        <i class="bi bi-calendar"></i>
                        Hired: @trainer.HireDate.ToString("dd MMM yyyy")
                    </p>

                    <!-- Members Count -->
                    <div class="alert alert-light py-1 px-3 mb-2 d-inline-block">
                        <i class="bi bi-people text-primary"></i>
                        <strong>@trainer.Members.Count()</strong> member(s) assigned
                    </div>

                    <br />

                    <!-- Active Status -->
                    @if (trainer.IsActive)
                    {
                        <span class="badge bg-success">
                            <i class="bi bi-check-circle"></i> Active
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactive</span>
                    }
                </div>

                <!-- Action Buttons -->
                <div class="card-footer bg-white border-0
                    d-flex gap-2 justify-content-center pb-3">

                    <!-- Details — NEW -->
                    <a asp-action="Details" asp-route-id="@trainer.Id"
                           class="btn btn-sm btn-outline-info" title="View Members">
                        <i class="bi bi-eye"></i> Details
                    </a>

                    <!-- Edit -->
                    <a asp-action="Edit" asp-route-id="@trainer.Id"
                           class="btn btn-sm btn-outline-warning" title="Edit">
                        <i class="bi bi-pencil"></i> Edit
                    </a>

                    <!-- Delete — Admin Only -->
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-action="Delete" asp-route-id="@trainer.Id"
                               class="btn btn-sm btn-outline-danger"
                               onclick="return confirm('Delete this trainer? Assigned members will be unassigned.')"
                               title="Delete">
                            <i class="bi bi-trash"></i>
                        </a>
                    }
                </div>
            </div>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="col-12 text-center text-muted py-5">
            <i class="bi bi-inbox fs-1 d-block mb-2"></i>
            No trainers found.
            <div class="mt-2">
                <a asp-action="Create" class="btn btn-success btn-sm">
                    <i class="bi bi-plus-lg"></i> Add First Trainer
                </a>
            </div>
        </div>
    }
</div>