@model GymManagementSystem.Models.Member
@{
    ViewData["Title"] = "Member Details";
}

<div class="d-flex align-items-center gap-2 mb-4">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left"></i>
    </a>
    <h4 class="fw-bold mb-0"><i class="bi bi-person-lines-fill"></i> Member Details</h4>
</div>

<div class="row g-4">
    <!-- Profile Card -->
    <div class="col-md-4">
        <div class="card border-0 shadow-sm text-center p-4">
            <div class="rounded-circle bg-primary text-white d-flex align-items-center
                justify-content-center fw-bold mx-auto mb-3"
                 style="width:80px;height:80px;font-size:2rem;">
                @Model.FullName.Substring(0, 1).ToUpper()
            </div>
            <h5 class="fw-bold">@Model.FullName</h5>
            <p class="text-muted mb-1">@Model.Email</p>
            <p class="text-muted">@Model.Phone</p>
            @if (Model.IsActive)
            {
                <span class="badge bg-success">Active</span>
            }
            else
            {
                <span class="badge bg-secondary">Inactive</span>
            }
            <hr />
            <div class="text-start small">
                <div class="mb-2">
                    <i class="bi bi-calendar text-primary"></i>
                    <strong> Join Date:</strong> @Model.JoinDate.ToString("dd MMM yyyy")
                </div>
                <div class="mb-2">
                    <i class="bi bi-cake text-warning"></i>
                    <strong> DOB:</strong> @Model.DateOfBirth.ToString("dd MMM yyyy")
                </div>
                <div>
                    <i class="bi bi-person-badge text-success"></i>
                    <strong> Trainer:</strong>
                    @(Model.Trainer?.FullName ?? "Not Assigned")
                </div>
            </div>
            <div class="mt-3">
                <a asp-action="Edit" asp-route-id="@Model.Id"
                       class="btn btn-warning btn-sm w-100">
                    <i class="bi bi-pencil"></i> Edit
                </a>
            </div>
        </div>
    </div>

    <!-- Subscriptions -->
    <div class="col-md-8">
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header bg-white fw-semibold d-flex justify-content-between">
                <span><i class="bi bi-credit-card text-primary"></i> Subscriptions</span>
                <a asp-controller="Subscriptions" asp-action="Create"
                       asp-route-memberId="@Model.Id"
                       class="btn btn-sm btn-primary">
                    <i class="bi bi-plus"></i> Add
                </a>
            </div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Plan</th>
                            <th>Start</th>
                            <th>End</th>
                            <th>Amount</th>
                            <th>Paid</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sub in Model.Subscriptions.OrderByDescending(s => s.StartDate))
                        {
                            <tr>
                                <td>@sub.Plan</td>
                                <td>@sub.StartDate.ToString("dd MMM yyyy")</td>
                                <td>@sub.EndDate.ToString("dd MMM yyyy")</td>
                                <td>Rs. @sub.Amount.ToString("N0")</td>
                                <td>
                                    @if (sub.IsPaid)
                                    {
                                        <i class="bi bi-check-circle-fill text-success"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-x-circle-fill text-danger"></i>
                                    }
                                </td>
                                <td>
                                    @if (sub.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Expired</span>
                                    }
                                </td>
                            </tr>
                        }
                        @if (!Model.Subscriptions.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-3">
                                    No subscriptions yet.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Recent Attendance -->
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white fw-semibold">
                <i class="bi bi-calendar-check text-success"></i> Recent Attendance
            </div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Check In</th>
                            <th>Check Out</th>
                            <th>Duration</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var att in Model.Attendances.OrderByDescending(a => a.CheckIn).Take(5))
                        {
                            <tr>
                                <td>@att.CheckIn.ToString("dd MMM yyyy hh:mm tt")</td>
                                <td>
                                    @(att.CheckOut.HasValue
                                        ? att.CheckOut.Value.ToString("hh:mm tt")
                                        : "—")
                                </td>
                                <td>
                                    @if (att.Duration.HasValue)
                                    {
                                        @($"{(int)att.Duration.Value.TotalHours}h {att.Duration.Value.Minutes}m")
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">In Gym</span>
                                    }
                                </td>
                            </tr>
                        }
                        @if (!Model.Attendances.Any())
                        {
                            <tr>
                                <td colspan="3" class="text-center text-muted py-3">
                                    No attendance records.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>