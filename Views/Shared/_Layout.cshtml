<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — GymPro</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
            body { background-color: #f8f9fa; }
            .navbar-brand { font-weight: 700; font-size: 1.4rem; }
            .nav-link:hover { color: #ffc107 !important; }
            .sidebar { min-height: calc(100vh - 56px); background: #212529; padding-top: 1rem; }
            .sidebar .nav-link { color: #adb5bd; padding: .6rem 1.2rem; border-radius: 6px; margin: 2px 8px; }
            .sidebar .nav-link:hover, .sidebar .nav-link.active { background: #343a40; color: #fff; }
            .sidebar .nav-link i { width: 20px; }
            .sidebar .section-label { color: #6c757d; font-size: .7rem; text-transform: uppercase;
                                       letter-spacing: 1px; padding: .5rem 1.2rem; margin-top: .5rem; }
            .main-content { padding: 1.5rem; }
    </style>
</head>
<body>

    <!-- TOP NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark px-3">
        <a class="navbar-brand" href="/"><i class="bi bi-lightning-fill text-warning"></i> GymPro</a>
        <div class="ms-auto d-flex align-items-center gap-3">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <span class="text-secondary small">
                    <i class="bi bi-person-circle"></i> @User.Identity.Name
                    @if (User.IsInRole("Admin"))
                    {
                        <span class="badge bg-warning text-dark ms-1">Admin</span>
                    }
                    else
                    {
                        <span class="badge bg-info text-dark ms-1">Operator</span>
                    }
                </span>
                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button class="btn btn-sm btn-outline-light">
                        <i class="bi bi-box-arrow-right"></i> Logout
                    </button>
                </form>
            }
        </div>
    </nav>

    <div class="container-fluid">
        <div class="row">

            @if (User.Identity?.IsAuthenticated == true)
            {
                <!-- SIDEBAR -->
                <div class="col-auto col-md-2 sidebar d-flex flex-column p-0">
                    <ul class="nav flex-column mt-2">

                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")"
                                   asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door"></i> Dashboard
                            </a>
                        </li>

                        <div class="section-label">Management</div>

                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Members" ? "active" : "")"
                                   asp-controller="Members" asp-action="Index">
                                <i class="bi bi-people"></i> Members
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Trainers" ? "active" : "")"
                                   asp-controller="Trainers" asp-action="Index">
                                <i class="bi bi-person-badge"></i> Trainers
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Attendance" ? "active" : "")"
                                   asp-controller="Attendance" asp-action="Index">
                                <i class="bi bi-calendar-check"></i> Attendance
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Subscriptions" ? "active" : "")"
                                   asp-controller="Subscriptions" asp-action="Index">
                                <i class="bi bi-credit-card"></i> Subscriptions
                            </a>
                        </li>

                        @* ── ADMIN ONLY ── *@
                        @if (User.IsInRole("Admin"))
                        {
                            <div class="section-label">Admin</div>

                            <li class="nav-item">
                                <a class="nav-link text-warning @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" ? "active" : "")"
                                       asp-controller="Reports" asp-action="Index">
                                    <i class="bi bi-bar-chart-fill"></i> Reports
                                </a>
                            </li>
                            <li class="nav-item">
        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Users" ? "active" : "")"
           asp-controller="Users" asp-action="Index">
            <i class="bi bi-people-fill text-info"></i>
            <span class="text-info">Users</span>
        </a>
    </li>
                        }

                    </ul>
                </div>
            }

            <!-- MAIN CONTENT -->
            <div class="col main-content">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="bi bi-check-circle"></i> @TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-triangle"></i> @TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                @RenderBody()
            </div>

        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>